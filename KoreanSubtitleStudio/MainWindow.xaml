<Window x:Class="KoreanSubtitleStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="한국어 자막 스튜디오" Width="960" Height="700" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FC" FontFamily="Malgun Gothic"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#182238"/>
    <SolidColorBrush x:Key="Muted" Color="#6E7890"/>
    <SolidColorBrush x:Key="Accent" Color="#635BFF"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#34405A"/>
      <Setter Property="Background" Value="#EEF1F8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="24,13"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="#E5E8F0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
  </Window.Resources>

  <Grid Margin="32,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="한국어 자막 스튜디오" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="SRT를 다양한 플랫폼용 WebVTT로 변환하세요" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#ECEBFF" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
        <TextBlock Text="UTF-8 · 한국어 최적화" Foreground="#514AD0" FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="파일 목록" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="SRT 추가" Click="OnAddFiles" Margin="0,0,8,0"/>
              <Button Content="전체 삭제" Click="OnClearFiles"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" BorderBrush="#DDE2EC" BorderThickness="1" CornerRadius="12" Background="#FBFCFF">
            <Grid>
              <ListBox x:Name="InputList" BorderThickness="0" Background="Transparent" Margin="9" Foreground="#354158"/>
              <StackPanel x:Name="EmptyGuide" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Background="#EFEEFF" Width="54" Height="54" CornerRadius="27">
                  <TextBlock Text="↓" FontSize="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SRT 파일을 끌어다 놓으세요" FontWeight="SemiBold" Foreground="#526079" Margin="0,14,0,0"/>
                <TextBlock Text="여러 파일을 동시에 처리할 수 있습니다" FontSize="11" Foreground="#98A1B3" Margin="0,5,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock x:Name="CountLabel" Grid.Row="4" Text="0개 파일" Foreground="{StaticResource Muted}"/>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="출력 설정" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="저장 위치" Margin="0,24,0,8" Foreground="#4C5870" FontWeight="SemiBold"/>
          <ComboBox x:Name="DestinationChoice" SelectedIndex="0" Height="40" Padding="9">
            <ComboBoxItem Content="SRT와 같은 폴더"/><ComboBoxItem Content="VTT 하위 폴더"/>
          </ComboBox>
          <CheckBox x:Name="OverwriteChoice" Content="같은 이름 파일 덮어쓰기" Margin="0,16,0,0" Foreground="#4C5870"/>
          <Separator Margin="0,22" Background="#E7EAF1"/>
          <TextBlock Text="시간 보정" Foreground="#4C5870" FontWeight="SemiBold"/>
          <TextBlock Text="자막을 앞당기려면 음수를 입력하세요" FontSize="11" Foreground="#919BAD" Margin="0,5,0,9"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ShiftInput" Text="0.000" Height="40" Padding="10" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="초" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <Border Background="#F1F0FF" CornerRadius="10" Padding="13" Margin="0,22,0,0">
            <StackPanel>
              <TextBlock Text="한글 인코딩 보호" Foreground="#514AD0" FontWeight="SemiBold"/>
              <TextBlock Text="UTF-8, UTF-16, CP949를 자동 인식하고 결과는 UTF-8 BOM으로 저장합니다." TextWrapping="Wrap" FontSize="11" LineHeight="18" Foreground="#6662A5" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StateLabel" Text="변환할 파일을 추가해 주세요." Foreground="#59657B"/>
          <ProgressBar x:Name="WorkProgress" Height="5" Margin="0,9,25,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#E9EBF2"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="FolderButton" Content="결과 열기" Visibility="Collapsed" Click="OnOpenFolder" Margin="0,0,8,0"/>
          <Button x:Name="StartButton" Content="VTT 변환 시작" Style="{StaticResource AccentButton}" Click="OnStart" MinWidth="150"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
