<Window x:Class="KoreanSubtitleStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRT → VTT 자막 변환기" Width="1020" Height="740" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F7FC" FontFamily="Malgun Gothic"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#182238"/>
    <SolidColorBrush x:Key="Muted" Color="#6E7890"/>
    <SolidColorBrush x:Key="Accent" Color="#635BFF"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#34405A"/>
      <Setter Property="Background" Value="#EEF1F8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="24,13"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="#E5E8F0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="WorkspaceTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="#7A8499"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Background="Transparent" CornerRadius="8" Padding="16,8">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="White"/>
              <Setter Property="Foreground" Value="#514AD0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="#F9F9FF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="32,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="SRT → VTT 자막 변환기" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="SRT를 다양한 플랫폼용 WebVTT로 변환하세요" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#ECEBFF" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
        <TextBlock Text="UTF-8 · 한국어 최적화" Foreground="#514AD0" FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="파일 목록" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="SRT 추가" Click="OnAddFiles" Margin="0,0,8,0"/>
              <Button Content="전체 삭제" Click="OnClearFiles"/>
            </StackPanel>
          </Grid>
          <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Background="#F1F2F8" BorderBrush="#E2E5EE" BorderThickness="1"
                      Padding="6" ItemContainerStyle="{StaticResource WorkspaceTab}">
            <TabControl.Template>
              <ControlTemplate TargetType="TabControl">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Border Background="#F1F2F8" CornerRadius="11" Padding="4">
                    <TabPanel IsItemsHost="True"/>
                  </Border>
                  <Border Grid.Row="2" Background="#FBFCFF" BorderBrush="#E2E5EE" BorderThickness="1" CornerRadius="12">
                    <ContentPresenter ContentSource="SelectedContent"/>
                  </Border>
                </Grid>
              </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="파일 목록">
              <Grid Background="Transparent" Margin="4">
                <ListBox x:Name="InputList" BorderThickness="0" Background="Transparent" Margin="7" Foreground="#354158" SelectionChanged="OnInputSelectionChanged">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel x:Name="EmptyGuide" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Border Background="#EFEEFF" Width="54" Height="54" CornerRadius="27">
                    <TextBlock Text="↓" FontSize="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="SRT 파일을 끌어다 놓으세요" FontWeight="SemiBold" Foreground="#526079" Margin="0,14,0,0"/>
                  <TextBlock Text="여러 파일을 동시에 처리할 수 있습니다" FontSize="11" Foreground="#98A1B3" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="VTT 미리보기">
              <Grid Background="Transparent" Margin="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="12,9">
                  <StackPanel>
                    <TextBlock x:Name="PreviewTitle" Text="파일을 선택해 주세요" Foreground="#354158" FontWeight="SemiBold"/>
                    <TextBlock Text="저장될 WebVTT 내용을 미리 확인할 수 있습니다" Foreground="#929CAF" FontSize="10" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button Content="↻  새로고침" HorizontalAlignment="Right" Padding="12,7" Click="OnRefreshPreview"/>
                </Grid>
                <TextBox x:Name="PreviewText" Grid.Row="1" Text="파일 목록에서 미리 볼 SRT를 선택해 주세요."
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                         FontSize="12" Foreground="#343C52" Background="#F7F8FC" BorderBrush="#E4E7EF" BorderThickness="1"
                         Padding="15" Margin="8,0,8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </TabItem>
          </TabControl>
          <TextBlock x:Name="CountLabel" Grid.Row="4" Text="0개 파일" Foreground="{StaticResource Muted}"/>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="출력 설정" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="저장 위치" Margin="0,24,0,8" Foreground="#4C5870" FontWeight="SemiBold"/>
          <ComboBox x:Name="DestinationChoice" SelectedIndex="0" Height="40" Padding="9" SelectionChanged="OnDestinationChanged">
            <ComboBoxItem Content="SRT와 같은 폴더"/><ComboBoxItem Content="VTT 하위 폴더"/><ComboBoxItem Content="직접 폴더 지정"/>
          </ComboBox>
          <Grid x:Name="CustomFolderPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="CustomFolderInput" Height="38" Padding="9" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="선택한 출력 폴더"/>
            <Button Grid.Column="1" Content="찾아보기" Padding="12,9" Margin="8,0,0,0" Click="OnBrowseFolder"/>
          </Grid>
          <CheckBox x:Name="OverwriteChoice" Content="같은 이름 파일 덮어쓰기" Margin="0,16,0,0" Foreground="#4C5870"/>
          <Separator Margin="0,22" Background="#E7EAF1"/>
          <TextBlock Text="시간 보정" Foreground="#4C5870" FontWeight="SemiBold"/>
          <TextBlock Text="자막을 앞당기려면 음수를 입력하세요" FontSize="11" Foreground="#919BAD" Margin="0,5,0,9"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ShiftInput" Text="0.000" Height="40" Padding="10" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="초" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <Border Background="#F1F0FF" CornerRadius="10" Padding="13" Margin="0,22,0,0">
            <StackPanel>
              <TextBlock Text="한글 인코딩 보호" Foreground="#514AD0" FontWeight="SemiBold"/>
              <TextBlock Text="UTF-8, UTF-16, CP949를 자동 인식하고 결과는 UTF-8 BOM으로 저장합니다." TextWrapping="Wrap" FontSize="11" LineHeight="18" Foreground="#6662A5" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StateLabel" Text="변환할 파일을 추가해 주세요." Foreground="#59657B"/>
          <ProgressBar x:Name="WorkProgress" Height="5" Margin="0,9,25,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#E9EBF2"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="FolderButton" Content="결과 열기" Visibility="Collapsed" Click="OnOpenFolder" Margin="0,0,8,0"/>
          <Button x:Name="StartButton" Content="VTT 변환 시작" Style="{StaticResource AccentButton}" Click="OnStart" MinWidth="150"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
